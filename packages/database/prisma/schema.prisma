// ============================================================================
//  SCHEMA PRISMA - APLIKASI CATERING MAKANAN
//  Role   : ADMIN, KASIR (keuangan), DAPUR (staff), PELANGGAN
//  Fitur  : Katalog & paket menu, keranjang, pemesanan, voucher, ongkir,
//           produksi dapur, pengiriman, payment gateway (DP/pelunasan/refund),
//           kasir & shift, inventori bahan, pengeluaran, review, notifikasi,
//           audit log
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
//  ENUMS
// ============================================================================

enum Role {
  ADMIN
  KASIR // keuangan / kasir
  DAPUR // staff dapur
  PELANGGAN
}

enum ProductType {
  SINGLE // menu satuan (nasi box, tumpeng, snack, dll)
  PACKAGE // paket (gabungan beberapa menu)
}

enum OrderSource {
  ONLINE // pesan lewat aplikasi/web
  POS // dibuatkan kasir di tempat
  WHATSAPP // dibuatkan admin/kasir dari chat
}

enum FulfillmentType {
  DELIVERY // diantar
  PICKUP // ambil sendiri
}

enum OrderStatus {
  PENDING // order dibuat, belum dibayar
  WAITING_PAYMENT // menunggu pembayaran (invoice terbit)
  PAID // lunas / DP sudah masuk
  CONFIRMED // dikonfirmasi admin
  PREPARING // sedang diproduksi dapur
  READY // siap dikirim / diambil
  DELIVERING // dalam pengiriman
  COMPLETED // selesai
  CANCELLED // dibatalkan
  REFUNDED // dana dikembalikan
}

enum PaymentScheme {
  FULL // bayar penuh
  DOWN_PAYMENT // DP lalu pelunasan
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID // DP sudah dibayar
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  FULL
  DOWN_PAYMENT
  SETTLEMENT // pelunasan
}

enum PaymentGateway {
  MIDTRANS
  XENDIT
  DOKU
  MANUAL // cash / transfer manual / EDC (tanpa gateway)
}

enum PaymentMethod {
  VIRTUAL_ACCOUNT
  QRIS
  EWALLET
  CREDIT_CARD
  RETAIL_OUTLET // Alfamart / Indomaret
  BANK_TRANSFER // transfer manual (butuh verifikasi kasir)
  CASH
  EDC
}

enum PaymentTxStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ProductionStatus {
  QUEUED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum DeliveryStatus {
  WAITING
  ASSIGNED
  ON_THE_WAY
  DELIVERED
  FAILED
  RETURNED
}

enum StockMovementType {
  PURCHASE // barang masuk (belanja bahan)
  USAGE // dipakai produksi
  ADJUSTMENT // koreksi stok opname
  WASTE // terbuang / rusak
  RETURN
}

enum ExpenseCategory {
  BAHAN_BAKU
  GAJI
  OPERASIONAL
  TRANSPORT
  PERALATAN
  MARKETING
  LAINNYA
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum NotificationType {
  ORDER
  PAYMENT
  PRODUCTION
  DELIVERY
  PROMO
  SYSTEM
}

// ============================================================================
//  USER, PROFIL & AUTH
// ============================================================================

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  phone           String?   @unique
  name            String
  passwordHash    String
  role            Role      @default(PELANGGAN)
  avatarUrl       String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // profil sesuai role
  customerProfile CustomerProfile?
  staffProfile    StaffProfile?

  // relasi umum
  sessions      Session[]
  addresses     Address[]
  cart          Cart?
  notifications Notification[]
  auditLogs     AuditLog[]
  reviews       Review[]
  voucherUsages VoucherUsage[]

  // sebagai pelanggan / kasir pada order
  customerOrders Order[] @relation("CustomerOrders")
  cashierOrders  Order[] @relation("CashierOrders")
  statusChanges  OrderStatusHistory[]

  // kasir / keuangan
  verifiedPayments Payment[]       @relation("PaymentVerifier")
  cashierShifts    CashierShift[]
  expenses         Expense[]
  refundsRequested Refund[]        @relation("RefundRequester")
  refundsApproved  Refund[]        @relation("RefundApprover")

  // dapur
  productionTasks ProductionTask[] @relation("AssignedTasks")
  stockMovements  StockMovement[]

  @@index([role])
}

model CustomerProfile {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String? // untuk pelanggan korporat
  taxNumber     String? // NPWP
  birthDate     DateTime?
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StaffProfile {
  id           Int       @id @default(autoincrement())
  userId       Int       @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode String    @unique
  position     String? // contoh: Chef, Helper, Kasir Senior
  joinDate     DateTime?
  salary       Decimal?  @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String // Rumah, Kantor, Lokasi Acara
  recipientName String
  phone         String
  street        String
  district      String? // kecamatan
  city          String
  province      String
  postalCode    String?
  latitude      Float?
  longitude     Float?
  notes         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

// ============================================================================
//  KATALOG MENU
// ============================================================================

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id            Int         @id @default(autoincrement())
  categoryId    Int
  category      Category    @relation(fields: [categoryId], references: [id])
  sku           String?     @unique
  name          String
  slug          String      @unique
  description   String?
  type          ProductType @default(SINGLE)
  basePrice     Decimal     @db.Decimal(12, 2)
  unit          String      @default("porsi") // porsi, box, paket, tray
  minOrderQty   Int         @default(1)
  maxOrderQty   Int?
  leadTimeHours Int         @default(24) // minimal H-berapa jam harus dipesan
  dailyCapacity Int? // kapasitas produksi harian (opsional)
  isAvailable   Boolean     @default(true)
  isFeatured    Boolean     @default(false)
  calories      Int?
  allergens     String? // kacang, seafood, dll
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime? // soft delete

  images      ProductImage[]
  variants    ProductVariant[]
  recipeItems RecipeItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]

  // jika type = PACKAGE
  packageItems PackageItem[] @relation("PackageParent")
  includedIn   PackageItem[] @relation("PackageChild")

  @@index([categoryId])
  @@index([isAvailable])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

// Variasi harga/ukuran, contoh: "Small (10 pax)", "Large (50 pax)"
model ProductVariant {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String
  sku         String?  @unique
  price       Decimal  @db.Decimal(12, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

// Isi paket: Paket A = nasi + ayam + sayur + es teh
model PackageItem {
  id        Int     @id @default(autoincrement())
  packageId Int
  package   Product @relation("PackageParent", fields: [packageId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation("PackageChild", fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([packageId, productId])
}

// ============================================================================
//  INVENTORI BAHAN BAKU (DAPUR)
// ============================================================================

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  ingredients Ingredient[]
  expenses    Expense[]
}

model Ingredient {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  unit         String // kg, gram, liter, pcs
  stock        Decimal  @default(0) @db.Decimal(12, 3)
  minStock     Decimal  @default(0) @db.Decimal(12, 3) // batas peringatan stok menipis
  costPerUnit  Decimal  @default(0) @db.Decimal(12, 2)
  supplierId   Int?
  supplier     Supplier? @relation(fields: [supplierId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipeItems    RecipeItem[]
  stockMovements StockMovement[]
}

// Resep: kebutuhan bahan per 1 unit produk
model RecipeItem {
  id            Int        @id @default(autoincrement())
  productId     Int
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId  Int
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  quantityPerUnit Decimal  @db.Decimal(12, 3)

  @@unique([productId, ingredientId])
}

model StockMovement {
  id           Int               @id @default(autoincrement())
  ingredientId Int
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id])
  type         StockMovementType
  quantity     Decimal           @db.Decimal(12, 3) // positif = masuk, negatif = keluar
  unitCost     Decimal?          @db.Decimal(12, 2)
  orderId      Int? // jika dipakai untuk produksi order tertentu
  order        Order?            @relation(fields: [orderId], references: [id])
  note         String?
  createdById  Int
  createdBy    User              @relation(fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([ingredientId])
  @@index([orderId])
}

// ============================================================================
//  KERANJANG
// ============================================================================

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int             @id @default(autoincrement())
  cartId    Int
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  notes     String? // catatan: tanpa pedas, dll
  createdAt DateTime        @default(now())

  @@index([cartId])
}

// ============================================================================
//  VOUCHER & ONGKIR
// ============================================================================

model Voucher {
  id            Int          @id @default(autoincrement())
  code          String       @unique
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  maxDiscount   Decimal?     @db.Decimal(12, 2) // batas maksimum untuk tipe persen
  minOrderAmount Decimal     @default(0) @db.Decimal(12, 2)
  quota         Int? // total kuota pemakaian
  usedCount     Int          @default(0)
  perUserLimit  Int          @default(1)
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  orders Order[]
  usages VoucherUsage[]
}

model VoucherUsage {
  id        Int      @id @default(autoincrement())
  voucherId Int
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  orderId   Int      @unique
  order     Order    @relation(fields: [orderId], references: [id])
  discount  Decimal  @db.Decimal(12, 2)
  usedAt    DateTime @default(now())

  @@index([voucherId, userId])
}

model DeliveryZone {
  id               Int      @id @default(autoincrement())
  name             String // Bandung Kota, Cimahi, dll
  fee              Decimal  @db.Decimal(12, 2)
  minOrderAmount   Decimal  @default(0) @db.Decimal(12, 2)
  freeShippingOver Decimal? @db.Decimal(12, 2)
  estimatedMinutes Int?
  isActive         Boolean  @default(true)

  orders Order[]
}

// ============================================================================
//  PEMESANAN
// ============================================================================

model Order {
  id          Int             @id @default(autoincrement())
  orderNumber String          @unique // contoh: ORD-20261009-0001
  source      OrderSource     @default(ONLINE)
  status      OrderStatus     @default(PENDING)

  customerId  Int
  customer    User            @relation("CustomerOrders", fields: [customerId], references: [id])
  cashierId   Int? // jika dibuat/ditangani kasir
  cashier     User?           @relation("CashierOrders", fields: [cashierId], references: [id])

  // jadwal acara / pengiriman
  fulfillmentType FulfillmentType @default(DELIVERY)
  eventName       String? // contoh: Rapat Tahunan, Pernikahan
  eventDate       DateTime // tanggal & jam makanan dibutuhkan
  guestCount      Int?

  // alamat (relasi + snapshot agar histori tidak berubah)
  addressId       Int?
  address         Address?       @relation(fields: [addressId], references: [id])
  shippingName    String?
  shippingPhone   String?
  shippingAddress String?
  deliveryZoneId  Int?
  deliveryZone    DeliveryZone?  @relation(fields: [deliveryZoneId], references: [id])

  // nominal
  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @db.Decimal(12, 2)
  serviceFee     Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  paidAmount     Decimal @default(0) @db.Decimal(12, 2)

  // pembayaran
  paymentScheme  PaymentScheme @default(FULL)
  dpPercentage   Int? // contoh 50 (%)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentDueAt   DateTime? // batas waktu pembayaran

  voucherId Int?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  customerNotes String?
  internalNotes String? // catatan internal admin/dapur
  cancelReason  String?
  cancelledAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  invoices       Invoice[]
  refunds        Refund[]
  productionTasks ProductionTask[]
  delivery       Delivery?
  voucherUsage   VoucherUsage?
  reviews        Review[]
  stockMovements StockMovement[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([eventDate])
  @@index([createdAt])
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product         @relation(fields: [productId], references: [id])
  variantId   Int?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  // snapshot agar histori tidak berubah saat harga/nama produk diubah
  productName String
  variantName String?
  unitPrice   Decimal         @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal         @db.Decimal(12, 2)
  notes       String?

  productionTasks ProductionTask[]
  review          Review?

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id          Int          @id @default(autoincrement())
  orderId     Int
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById Int?
  changedBy   User?        @relation(fields: [changedById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([orderId])
}

// ============================================================================
//  PRODUKSI DAPUR
// ============================================================================

model ProductionTask {
  id          Int              @id @default(autoincrement())
  orderId     Int
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId Int
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  assignedToId Int?
  assignedTo  User?            @relation("AssignedTasks", fields: [assignedToId], references: [id])
  status      ProductionStatus @default(QUEUED)
  priority    Int              @default(0) // makin besar makin prioritas
  dueAt       DateTime // target selesai (biasanya sebelum eventDate)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orderId])
  @@index([assignedToId, status])
  @@index([dueAt])
}

// ============================================================================
//  PENGIRIMAN
// ============================================================================

model Delivery {
  id            Int            @id @default(autoincrement())
  orderId       Int            @unique
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status        DeliveryStatus @default(WAITING)
  courierName   String?
  courierPhone  String?
  vehicleInfo   String?
  scheduledAt   DateTime?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  receivedBy    String? // nama penerima
  proofPhotoUrl String?
  failureReason String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ============================================================================
//  INVOICE & PAYMENT GATEWAY
// ============================================================================

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique // contoh: INV-20261009-0001
  orderId       Int
  order         Order         @relation(fields: [orderId], references: [id])
  status        InvoiceStatus @default(UNPAID)
  subtotal      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal      @default(0) @db.Decimal(12, 2)
  shippingFee   Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  issuedAt      DateTime      @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  pdfUrl        String?
  notes         String?

  payments Payment[]

  @@index([orderId])
}

model Payment {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  invoiceId Int?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  type    PaymentType     @default(FULL)
  gateway PaymentGateway  @default(MIDTRANS)
  method  PaymentMethod?
  channel String? // BCA, BNI, MANDIRI, GOPAY, OVO, SHOPEEPAY, dll
  status  PaymentTxStatus @default(PENDING)

  // ID yang dikirim ke gateway (harus unik per transaksi)
  externalId       String  @unique // contoh: PAY-ORD-20261009-0001-1
  gatewayTxId      String? @unique // transaction_id / payment id dari gateway
  paymentUrl       String? // redirect URL / Snap URL
  snapToken        String?
  vaNumber         String? // nomor virtual account
  qrString         String? // payload QRIS
  fraudStatus      String?

  amount           Decimal @db.Decimal(12, 2)
  feeAmount        Decimal @default(0) @db.Decimal(12, 2) // biaya MDR gateway
  currency         String  @default("IDR")

  expiresAt        DateTime?
  paidAt           DateTime?
  failureReason    String?
  gatewayResponse  Json? // raw response saat create transaksi

  // pembayaran manual (transfer / cash / EDC)
  proofUrl      String? // bukti transfer
  verifiedById  Int?
  verifiedBy    User?          @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  cashierShiftId Int?
  cashierShift  CashierShift?  @relation(fields: [cashierShiftId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds     Refund[]
  webhookLogs PaymentWebhookLog[]

  @@index([orderId])
  @@index([invoiceId])
  @@index([status])
  @@index([cashierShiftId])
}

// Log setiap notifikasi (webhook) dari gateway: untuk audit, debugging, idempotency
model PaymentWebhookLog {
  id             Int            @id @default(autoincrement())
  paymentId      Int?
  payment        Payment?       @relation(fields: [paymentId], references: [id])
  gateway        PaymentGateway
  eventType      String? // settlement, pending, expire, deny, cancel, refund
  externalId     String?
  eventId        String?        // ID event dari gateway untuk mencegah proses ganda
  payload        Json
  signatureValid Boolean        @default(false)
  processed      Boolean        @default(false)
  processedAt    DateTime?
  errorMessage   String?
  receivedAt     DateTime       @default(now())

  @@unique([gateway, eventId])
  @@index([externalId])
  @@index([processed])
}

model Refund {
  id              Int          @id @default(autoincrement())
  paymentId       Int
  payment         Payment      @relation(fields: [paymentId], references: [id])
  orderId         Int
  order           Order        @relation(fields: [orderId], references: [id])
  amount          Decimal      @db.Decimal(12, 2)
  reason          String
  status          RefundStatus @default(REQUESTED)
  gatewayRefundId String?
  requestedById   Int
  requestedBy     User         @relation("RefundRequester", fields: [requestedById], references: [id])
  approvedById    Int?
  approvedBy      User?        @relation("RefundApprover", fields: [approvedById], references: [id])
  processedAt     DateTime?
  gatewayResponse Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([paymentId])
  @@index([orderId])
}

// ============================================================================
//  KASIR & KEUANGAN
// ============================================================================

model CashierShift {
  id           Int         @id @default(autoincrement())
  cashierId    Int
  cashier      User        @relation(fields: [cashierId], references: [id])
  status       ShiftStatus @default(OPEN)
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openingCash  Decimal     @default(0) @db.Decimal(12, 2) // modal awal laci
  closingCash  Decimal?    @db.Decimal(12, 2) // uang fisik saat tutup
  expectedCash Decimal?    @db.Decimal(12, 2) // hasil hitung sistem
  difference   Decimal?    @db.Decimal(12, 2) // selisih
  notes        String?

  payments Payment[]

  @@index([cashierId, status])
}

model Expense {
  id          Int             @id @default(autoincrement())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @default(now())
  receiptUrl  String?
  supplierId  Int?
  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([expenseDate])
  @@index([category])
}

// ============================================================================
//  REVIEW, NOTIFIKASI, AUDIT, SETTING
// ============================================================================

model Review {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  productId   Int
  product     Product   @relation(fields: [productId], references: [id])
  orderId     Int
  order       Order     @relation(fields: [orderId], references: [id])
  orderItemId Int       @unique // satu item hanya bisa direview sekali
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  rating      Int // 1 - 5
  comment     String?
  photoUrl    String?
  adminReply  String?
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([productId])
  @@index([userId])
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json? // contoh: { "orderId": 12 }
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE, UPDATE, DELETE, LOGIN, REFUND_APPROVE, dll
  entity    String // nama tabel / modul
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// Pengaturan aplikasi (key-value): jam operasional, % pajak, % DP default, dll
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
